# ==============================================================================
# SAVORIA RECIPE STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or .env.local) and populate with your own credentials.
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (Never prefix with VITE_; strictly confidential)
# ------------------------------------------------------------------------------
# Google Gemini API Key for AI Recipe Formulation & Fallbacks
# Create or rotate key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Local Development / Server Port (Vite default is 5173; production server uses PORT)
PORT=5173

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Public web app parameters)
# Obtain from: Firebase Console > Project Settings > General > Your apps (Web)
# Scoped and protected by Firebase Auth & firestore.rules
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
